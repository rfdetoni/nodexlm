+                        // entire large tensor for buffered disk reads.
+                        if (scratch.empty()) { scratch.resize(1024 * 1024); }
+                        for (size_t off = 0; off < next.size;) {
+                            const size_t count = std::min(scratch.size(), next.size - off);
+                            {
