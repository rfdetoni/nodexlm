+    struct rpc_upload_worker {
+        struct task {
+            ggml_tensor * tensor = nullptr;
+            const void  * data   = nullptr;
+            size_t size         = 0;
+            llama_file * file   = nullptr;
+            size_t offset       = 0;
+        };
+        std::mutex mutex;
+        std::condition_variable wake;
+        std::deque<task> pending;
+        bool stopping = false;
+        std::exception_ptr failure;
+        std::atomic<size_t> & active;
+        std::atomic<size_t> & peak;
+        std::atomic<size_t> & queued_bytes;
+        std::mutex & file_mutex;
+        std::thread worker;
+
+        rpc_upload_worker(std::atomic<size_t> & a, std::atomic<size_t> & p, std::atomic<size_t> & q, std::mutex & f) : active(a), peak(p), queued_bytes(q), file_mutex(f), worker([this] {
+            std::vector<uint8_t> scratch;
+            for (;;) {
+                std::unique_lock<std::mutex> lock(mutex);
+                wake.wait(lock, [this] { return stopping || !pending.empty(); });
+                if (pending.empty() && stopping) {
+                    return;
+                }
+                const task next = pending.front();
+                pending.pop_front();
+                wake.notify_all();
+                lock.unlock();
+                const size_t now = active.fetch_add(1) + 1;
+                size_t seen = peak.load();
+                while (seen < now && !peak.compare_exchange_weak(seen, now)) {}
+                try {
+                    if (next.file) {
