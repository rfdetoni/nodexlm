+    // NodexLM: one long-lived worker per RPC device, each with a bounded
+    // queue of lightweight tensor descriptors (never tensor payload copies).
+    // GGUF mappings remain valid until all workers finish.
+    // Uploads to different Guests overlap; commands to the same Guest remain
+    // ordered. No tensor payload is copied into an additional staging buffer.
+    struct rpc_upload_worker {
+        struct task {
+            ggml_tensor * tensor = nullptr;
+            const void  * data   = nullptr;
+            size_t size         = 0;
+        };
+        std::mutex mutex;
+        std::condition_variable wake;
+        std::deque<task> pending;
+        bool stopping = false;
+        std::exception_ptr failure;
+        std::thread worker;
+
+        rpc_upload_worker() : worker([this] {
+            for (;;) {
+                std::unique_lock<std::mutex> lock(mutex);
+                wake.wait(lock, [this] { return stopping || !pending.empty(); });
+                if (pending.empty() && stopping) {
+                    return;
+                }
+                const task next = pending.front();
+                pending.pop_front();
+                wake.notify_all();
+                lock.unlock();
+                try {
+                    ggml_backend_tensor_set(next.tensor, next.data, 0, next.size);
+                } catch (...) {
+                    lock.lock();
+                    failure = std::current_exception();
+                    stopping = true;
+                    pending.clear();
+                    wake.notify_all();
+                    return;
+                }
+            }
+        }) {}
+
+        void submit(ggml_tensor * tensor, const void * data, size_t size) {
+            std::unique_lock<std::mutex> lock(mutex);
+            // Bounded metadata queue: even if layers are grouped by Guest,
+            // the producer can enqueue them before scheduling other Guests.
+            wake.wait(lock, [this] { return pending.size() < 8192 || failure != nullptr; });
+            if (failure) {
+                std::rethrow_exception(failure);
+            }
+            if (stopping) {
+                throw std::runtime_error("RPC tensor worker is stopped");
+            }
+            pending.push_back({tensor, data, size});
+            wake.notify_all();
+        }
+
+        void finish() {
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                stopping = true;
+                wake.notify_all();
+            }
+            if (worker.joinable()) {
+                worker.join();
+            }
+            if (failure) {
+                std::rethrow_exception(failure);
+            }
+        }
