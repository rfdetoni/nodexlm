if(NOT DEFINED SOURCE OR NOT DEFINED PATCH)
  message(FATAL_ERROR "SOURCE and PATCH are required")
endif()
execute_process(COMMAND git -C "${SOURCE}" apply --check "${PATCH}" RESULT_VARIABLE clean)
if(clean EQUAL 0)
  execute_process(COMMAND git -C "${SOURCE}" apply "${PATCH}" COMMAND_ERROR_IS_FATAL ANY)
else()
  execute_process(COMMAND git -C "${SOURCE}" apply --reverse --check "${PATCH}" RESULT_VARIABLE applied)
  if(NOT applied EQUAL 0)
    message(FATAL_ERROR "Pinned RPC patch cannot be applied to this source")
  endif()
endif()
