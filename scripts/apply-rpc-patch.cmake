if(NOT DEFINED SOURCE OR NOT DEFINED PATCH)
  message(FATAL_ERROR "SOURCE and PATCH are required")
endif()
execute_process(COMMAND git -C "${SOURCE}" apply --check "${PATCH}" RESULT_VARIABLE clean)
if(clean EQUAL 0)
  execute_process(COMMAND git -C "${SOURCE}" apply "${PATCH}" COMMAND_ERROR_IS_FATAL ANY)
else()
  execute_process(COMMAND git -C "${SOURCE}" apply --reverse --check "${PATCH}" RESULT_VARIABLE applied)
  if(NOT applied EQUAL 0)
    message(FATAL_ERROR "Pinned RPC patch cannot be applied to this source")
  endif()
endif()

# Android armeabi-v7a needs fixed 64-bit GGML RPC message lengths.
# Optionally apply a second pinned patch after the Unix socket transport patch.
if(DEFINED EXTRA_PATCH)
  execute_process(COMMAND git -C "${SOURCE}" apply --check "${EXTRA_PATCH}" RESULT_VARIABLE extra_clean)
  if(extra_clean EQUAL 0)
    execute_process(COMMAND git -C "${SOURCE}" apply "${EXTRA_PATCH}" COMMAND_ERROR_IS_FATAL ANY)
  else()
    execute_process(COMMAND git -C "${SOURCE}" apply --reverse --check "${EXTRA_PATCH}" RESULT_VARIABLE extra_applied)
    if(NOT extra_applied EQUAL 0)
      message(FATAL_ERROR "Pinned Android RPC wire-format patch cannot be applied to this source")
    endif()
  endif()
endif()

# Android-only cooperative shutdown extension. Apply before CMake configures
# the fetched source; desktop RPC runtime never receives this patch.
if(DEFINED ANDROID_SHUTDOWN_PATCH)
  execute_process(COMMAND git -C "${SOURCE}" apply --check "${ANDROID_SHUTDOWN_PATCH}" RESULT_VARIABLE shutdown_clean)
  if(shutdown_clean EQUAL 0)
    execute_process(COMMAND git -C "${SOURCE}" apply "${ANDROID_SHUTDOWN_PATCH}" COMMAND_ERROR_IS_FATAL ANY)
  else()
    execute_process(COMMAND git -C "${SOURCE}" apply --reverse --check "${ANDROID_SHUTDOWN_PATCH}" RESULT_VARIABLE shutdown_applied)
    if(NOT shutdown_applied EQUAL 0)
      message(FATAL_ERROR "Pinned Android RPC shutdown patch cannot be applied to this source")
    endif()
  endif()
endif()

# Upgrade the pinned upstream KleidiAI download verification from MD5 to
# the SHA-256 of the published immutable source archive before configure.
if(DEFINED KLEIDIAI_SHA_PATCH)
  execute_process(COMMAND git -C "${SOURCE}" apply --check "${KLEIDIAI_SHA_PATCH}" RESULT_VARIABLE kleidi_clean)
  if(kleidi_clean EQUAL 0)
    execute_process(COMMAND git -C "${SOURCE}" apply "${KLEIDIAI_SHA_PATCH}" COMMAND_ERROR_IS_FATAL ANY)
  else()
    execute_process(COMMAND git -C "${SOURCE}" apply --reverse --check "${KLEIDIAI_SHA_PATCH}" RESULT_VARIABLE kleidi_applied)
    if(NOT kleidi_applied EQUAL 0)
      message(FATAL_ERROR "Pinned KleidiAI SHA-256 patch cannot be applied")
    endif()
  endif()
endif()

# Bounded Android-only weight cache. No desktop cache behavior change.
if(DEFINED ANDROID_CACHE_PATCH)
  execute_process(COMMAND git -C "${SOURCE}" apply --check "${ANDROID_CACHE_PATCH}" RESULT_VARIABLE cache_clean)
  if(cache_clean EQUAL 0)
    execute_process(COMMAND git -C "${SOURCE}" apply "${ANDROID_CACHE_PATCH}" COMMAND_ERROR_IS_FATAL ANY)
  else()
    execute_process(COMMAND git -C "${SOURCE}" apply --reverse --check "${ANDROID_CACHE_PATCH}" RESULT_VARIABLE cache_applied)
    if(NOT cache_applied EQUAL 0)
      message(FATAL_ERROR "Pinned Android RPC cache patch cannot be applied")
    endif()
  endif()
endif()
