+bool rpc_server::get_cached_file(uint64_t hash, std::vector<uint8_t> & data) {
+    if (!cache_dir) {
+        return false;
+    }
+    char hash_str[17];
+    snprintf(hash_str, sizeof(hash_str), "%016" PRIx64, hash);
+    const fs::path cache_file = fs::path(cache_dir) / hash_str;
+    std::error_code ec;
+    if (!fs::is_regular_file(fs::symlink_status(cache_file, ec)) || ec) {
+        return false;
+    }
+    const auto size = fs::file_size(cache_file, ec);
+    if (ec || size == 0 || size > 16 * 1024 * 1024) {
+        return false;
+    }
+    std::ifstream ifs(cache_file, std::ios::binary);
+    data.resize(static_cast<size_t>(size));
+    if (!ifs.read(reinterpret_cast<char *>(data.data()), data.size()) ||
+        ifs.peek() != std::char_traits<char>::eof() ||
+        fnv_hash(data.data(), data.size()) != hash) {
+        data.clear();
+        return false;
+    }
+    return true;
+}
 
