+// This patch is applied only to the Android build (TCP/AF_UNIX, no RDMA).
+namespace {
+std::mutex android_rpc_socket_mutex;
+std::atomic<bool> android_rpc_stop_requested{false};
+socket_ptr android_rpc_listener;
+socket_ptr android_rpc_client;
+
+struct android_rpc_cleanup {
+    std::vector<ggml_backend_t> & backends;
+    bool transport_initialized = false;
+    ~android_rpc_cleanup() {
+        {
+            std::lock_guard<std::mutex> lock(android_rpc_socket_mutex);
+            android_rpc_client.reset();
+            android_rpc_listener.reset();
+        }
+        if (transport_initialized) rpc_transport_shutdown();
+        for (auto backend : backends) ggml_backend_free(backend);
+    }
+};
+}
+
+void ggml_backend_rpc_android_reset_stop(void) {
+    std::lock_guard<std::mutex> lock(android_rpc_socket_mutex);
+    android_rpc_stop_requested.store(false);
+}
+
+void ggml_backend_rpc_android_request_stop(void) {
+    std::lock_guard<std::mutex> lock(android_rpc_socket_mutex);
+    android_rpc_stop_requested.store(true);
+    if (android_rpc_client) android_rpc_client->interrupt();
+    if (android_rpc_listener) android_rpc_listener->interrupt();
+}
+
